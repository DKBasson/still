{
  "name": "still",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "description": "A quieter kind of social. Mutual-follow photography.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "wrangler types --env-interface CloudflareBindings && tsc --noEmit",
    "lint": "eslint .",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply still --local",
    "db:migrate:remote": "wrangler d1 migrations apply still --remote",
    "types": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "better-auth": "^1.7.11",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
